# restaurante_api/.env.example  ->  copiar a .env (no se sube al repo)

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Guayaquil
# En producción (detrás de HTTPS): DJANGO_SSL_REDIRECT=True, DJANGO_HSTS_SECONDS=31536000,
# DJANGO_CSRF_TRUSTED_ORIGINS=https://scaneats.midominio.com
LOGIN_THROTTLE_RATE=10/min
# CORS: solo hace falta si se agrega un frontend en OTRO origen (dominio/puerto distinto del backend).
# El panel (/) sirve del mismo origen que la API, así que por defecto esto va vacío.
# CORS_ALLOWED_ORIGINS=https://miapp.com,http://localhost:5173

# --- Caché (RF-13: límite de intentos de login) ---
# locmem = memoria del proceso (desarrollo; un solo worker). db = tabla compartida en la misma base de
# datos (requiere `manage.py createcachetable`; recomendado con varios workers de gunicorn). redis = la
# mejor opción si el tráfico crece (necesita un endpoint de ElastiCache y REDIS_URL).
CACHE_BACKEND=locmem
# REDIS_URL=redis://mi-cluster.xxxxxx.cache.amazonaws.com:6379/1

# --- Base de datos ---
# Sin DB_HOST se usa SQLite (db.sqlite3). Con DB_HOST se usa PostgreSQL (Amazon RDS).
# DB_HOST=scaneats.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_NAME=scaneats
# DB_USER=scaneats
# DB_PASSWORD=
# DB_PORT=5432
# DB_SSLMODE=require

# --- Evidencia de video ---
# local = disco (desarrollo)  |  s3 = bucket de S3 (producción)
CLIP_STORAGE_BACKEND=local
CLIP_MAX_MB=100
# AWS_STORAGE_BUCKET_NAME=scaneats-evidencia
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_SIGNED_URL_EXPIRES=300
# (sin claves: en EC2 se usa el rol IAM de la instancia)
# RNF-03: mínimo 30 días. Subir este valor solo si la política del restaurante lo pide.
EVIDENCIA_RETENCION_DIAS=30

# --- Token de servicio del Microservicio de Visión ---
SERVICIO_VISION_USERNAME=vision_service
