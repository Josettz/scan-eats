# vision_service/.env.example  ->  copiar a .env (no se sube al repo)

# --- Backend (restaurante_api) ---
VISION_API_URL=http://localhost:8000
# Token de servicio: python manage.py crear_servicio_vision  (en restaurante_api)
VISION_API_TOKEN=

# --- Video ---
# Archivo grabado, URL RTSP (rtsp://usuario:clave@ip:554/stream) o índice de webcam (0)
VIDEO_SOURCE=
VISION_CONFIG=config/zonas_ejemplo.json
PROCESS_FPS=5

# --- Modelo ---
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.35
TRACKER=sort            # sort | deepsort

# --- Evidencia en video (RF-14) ---
CLIPS_ENABLED=false
CLIP_PRE_S=8
CLIP_POST_S=8
CLIP_DIR=clips_tmp

LOG_LEVEL=INFO
